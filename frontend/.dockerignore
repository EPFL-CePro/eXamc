# Dependency artifacts — reinstalled fresh in the image via pnpm install
node_modules/
**/node_modules/

# Vite's local dependency-optimization cache — never needed in a build context
.vite/

# Build output — regenerated by `pnpm run build` inside the image;
# never useful to send in as build context, and could shadow the real build
dist/

# Package manager caches/logs
.pnpm-store/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript incremental build info
*.tsbuildinfo

# Editor/OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Env files — should never be baked into an image
.env
.env.*
!.env.example

# Git metadata — irrelevant inside the build context
.git/
.gitignore

# Test/coverage output, if present
coverage/
.nyc_output/

# Docs/readme, changelogs — not needed at build time
*.md
CHANGELOG*